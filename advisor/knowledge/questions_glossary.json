   "id": "questions_glossary.term-tpi",
   "title_tr": "TPI / diş sayısı",
   "intents": [
    "glossary"
   ],
   "questions_tr": [
    "TPI ne demek",
    "zpz nedir",
    "tpi nedir",
    "zpz ne demek",
    "tpi açılımı nedir",
    "diş sayısı ne demek",
    "6/10 ne demek",
    "1,4/2 ne anlama geliyor",
    "4/6 tpi ne demek",
    "8/12 yazıyor bu ne",
    "bıçaktaki 5/8 rakamı ne"
   ],
   "answer_tr": "TPI (teeth per inch), bıçağın bir inçlik (25,4 mm) boyundaki diş sayısıdır; Almanca kaynaklardaki ZpZ (Zähne pro Zoll) aynı anlamdadır. Yüksek TPI sık diştir (ince cidar, küçük kesit), düşük TPI seyrek diştir (kalın, büyük kesit). \"4/6\" gibi iki sayılı gösterim değişken diş, tek sayı sabit diştir.",
   "facts": [
    {
     "claim_tr": "TPI, 25,4 mm (1 inç) uzunluktaki diş sayısıdır.",
     "source_ids": [
      "ISO-4875-2-2006",
      "NIST-SP811"
     ],
     "status": "verified",
     "conditions": "",
     "value": "25.4",
     "unit": "mm",
     "audit_note": "2026-10-27 denetim: ISO 4875-2 metni ücretli; NIST yalnız 1 inç = 25,4 mm'yi doğruluyor. Tanım gereği doğru; ücretsiz bir birincil kaynak eklenmeli."
    },
    {
     "claim_tr": "Kesitte aynı anda en az üç diş çalışmalıdır.",
